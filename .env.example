# Copy this file to .env (DO NOT commit .env). Python reads it automatically.
# The app is designed for local 127.0.0.1 use (including within XAMPP/htdocs).
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
ALLOW_LOCAL_RESET_LINKS=0
# For deployed HTTPS only; local plain HTTP must keep this 0.
CRAWLINSIGHT_HTTPS=0
# Optional 32+ character signing key; otherwise generated in private DB folder.
# CRAWLINSIGHT_SECRET_KEY=choose-a-very-long-unique-secret-of-at-least-32-characters
# Database defaults to an OUTSIDE-htdocs folder when under C:\xampp\htdocs.
# CRAWLINSIGHT_DB_PATH=C:\xampp\ltw-th-private-data\crawlinsight.db

# REAL password reset needs SMTP. Example Gmail App Password, TLS 587:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=your-address@gmail.com
# Local development only: ALLOW_LOCAL_RESET_LINKS=1 reveals a reset link inside UI
# when SMTP is not configured. Do not enable on a public server.
