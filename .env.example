APP_NAME=CrawlInsight
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=vi

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# PHP and the Python crawler must point to the same SQLite file.
# Leave blank to use the shared default (outside htdocs when applicable).
CRAWLINSIGHT_DB_PATH=

SESSION_DRIVER=file
SESSION_LIFETIME=10080
# Set to 1 only when HTTPS is configured.
CRAWLINSIGHT_HTTPS=0
ALLOW_LOCAL_RESET_LINKS=0

# Password reset requires SMTP. Example Gmail App Password, TLS 587:
MAIL_MAILER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SCHEME=smtp
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional explicit path to the Python 3.11/3.12 executable used for crawling.
# Defaults to .venv/Scripts/python.exe on Windows and python3 elsewhere.
CRAWLINSIGHT_PYTHON=
